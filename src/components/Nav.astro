---
// The top menu, written once. Pass current="about" etc. to highlight a link.
const { current, extra = [] } = Astro.props;

const links = [
  { href: '/projects', label: 'Projects', key: 'projects' },
  { href: '/resume', label: 'Resume', key: 'resume' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/design', label: 'Design', key: 'design' },
];
---

<nav class="navbar">
  <div class="logo">
    <a href="/"><h3>DY</h3></a>
  </div>

  <ul class="nav-bar">
    <input type="checkbox" id="check" />
    <span class="menu">
      {links.map((link) => (
        <li><a href={link.href} id={current === link.key ? 'currentPage' : undefined} class="underline">{link.label}</a></li>
      ))}
      {extra.map((link) => (
        <li><a href={link.href} class="underline">{link.label}</a></li>
      ))}
      <label for="check" class="close-menu"><i class="fas fa-times"></i></label>
    </span>
    <label for="check" class="open-menu"><i class="fas fa-bars"></i></label>
  </ul>
</nav>
