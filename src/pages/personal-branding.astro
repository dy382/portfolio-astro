---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Doyeon Yoo | Personal Brand Board" styles={["/css/personal-branding.css", "/css/idmproject.css"]} showFooter={false}>
  <main class="container">

    <p class="eyebrow">
      Personal Brand Board · Doyeon Yoo
    </p>

    <section class="brand-board">

      <!-- Identity -->
      <article class="card identity">
        <div>
          <h2 class="card-title">Identity</h2>
        </div>

        <div>
          <h1>Doyeon Yoo</h1>
          <p class="role">
            UX / Product Designer · Human-centered digital experiences
          </p>
        </div>

        <p class="website">
          thoughtful design · meaningful experiences
        </p>
      </article>

      <!-- Unique Value Proposition -->
      <article class="card uvp">
        <h2 class="card-title">Unique Value Proposition</h2>
        <p>
          I turn complex problems into clear, approachable digital
          experiences by combining user research, purposeful visual
          design, and an understanding of how people interact with products.
        </p>
      </article>

      <!-- Target Audience -->
      <article class="card audience">
        <h2 class="card-title">Target Audience</h2>
        <p>
          Product teams, design collaborators, and organizations creating
          useful, inclusive digital experiences.
        </p>
      </article>

      <!-- Values -->
      <article class="card values">
        <h2 class="card-title">Values</h2>
        <p>
          Empathy · Curiosity · Clarity · Collaboration
        </p>
      </article>

      <!-- Challenges -->
      <article class="card challenges">
        <h2 class="card-title">Challenges</h2>
        <p>
          Balancing user needs, business goals, and technical constraints
          while keeping experiences intuitive.
        </p>
      </article>

      <!-- Opportunities -->
      <article class="card opportunities">
        <h2 class="card-title">Opportunities</h2>
        <p>
          Use research, iteration, and collaboration to make everyday
          digital experiences better.
        </p>
      </article>

      <!-- Color Palette -->
      <article class="card palette">
        <h2 class="card-title">Palette</h2>

        <div class="swatches">
          <div class="swatch">
            <div class="swatch-color" style="background:#36454F"></div>
            <span>#36454F</span>
          </div>

          <div class="swatch">
            <div class="swatch-color" style="background:#CE575A"></div>
            <span>#CE575A</span>
          </div>

          <div class="swatch">
            <div class="swatch-color" style="background:#5693C6"></div>
            <span>#5693C6</span>
          </div>

          <div class="swatch">
            <div class="swatch-color" style="background:#FEF9EE"></div>
            <span>#FEF9EE</span>
          </div>
        </div>
      </article>

      <!-- Typography -->
      <article class="card typography">
        <h2 class="card-title">Typography</h2>
        <div class="font-sample">Thoughtful.</div>
        <p class="font-description">
          Georgia for headlines<br>
          Arial for body text
        </p>
      </article>

      <!-- Imagery -->
      <article class="card imagery">
        <h2 class="card-title">Imagery / Mood</h2>
        <div class="mood-board">
          <div class="mood mood-one"></div>
          <div class="mood mood-two"></div>
          <div class="mood mood-three"></div>
        </div>
      </article>

      <!-- Voice -->
      <article class="card voice">
        <h2 class="card-title">Voice</h2>
        <p>
          Warm · Curious · Clear · Collaborative
        </p>
      </article>

      <!-- Goals -->
      <article class="card metrics">
        <h2 class="card-title">Experience & Goals</h2>

        <div class="metrics-grid">
          <div class="metric">
            <strong>Research</strong>
            <p>
              Understand people and identify meaningful problems.
            </p>
          </div>

          <div class="metric">
            <strong>Systems</strong>
            <p>
              Create consistent, intuitive design patterns.
            </p>
          </div>

          <div class="metric">
            <strong>Iteration</strong>
            <p>
              Prototype, test, learn, and improve.
            </p>
          </div>
        </div>
      </article>

      <!-- Channels -->
      <article class="card channels">
        <h2 class="card-title">Channels</h2>
        <div class="tags">
          <span class="tag">Portfolio</span>
          <span class="tag">LinkedIn</span>
          <span class="tag">Figma</span>
          <span class="tag">Case Studies</span>
        </div>
      </article>

    </section>

    <Footer />

  </main>
</Layout>
