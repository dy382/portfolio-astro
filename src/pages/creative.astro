---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Doyeon Yoo | Design" styles={["/css/style.css", "/css/creative.css"]} current="design" navExtra={[{ href: "photography.html", label: "Photos" }]}>
  <nav class="sidebar">
          <span class="sidebar-menu">
            <li><a href="/projects" class="underline">Projects</a></li>
            <li><a href="/resume" class="underline">Resume</a></li>
            <li><a href="/about" class="underline">About</a></li>
            <li><a href="/design" id="currentPage" class="underline">Design</a></li>
            <li><a href="photography.html" class="underline">Photos</a></li>   
            <label for="check" class="close-menu"><i class="fas fa-times"></i></label>
          </span>

  </nav>

  <section class="bento-section">


      <header>
          <h2>Latest Stories</h2>
      </header>


          <a href="/kims-dragon" class="box design">
            <div class="visual">
              <picture>
                <img src="/images/kimsDragon/kimsdragon-thumbnail.png" alt="Kim's Dragon Thumbnail">

              </picture>
            </div>
            <div class="info">
              <div class="info">
                  <h1>Graphic Design</h1>
                </div>
            </div>
          </a>


          <a href="/kims-dragon" class="box photos">
            <div class="visual">
              <picture>
                <img src="/images/LennoxGotLunch/lennoxgotlunch-thumbnail.png" alt="Kim's Dragon Thumbnail">

              </picture>
            </div>
            <div class="info">
              <h1>Photography</h1>
            </div>
          </a>



          <a href="/kims-dragon" class="box video">
              <div class="visual">
                <picture>
                  <img src="/images/kimsDragon/kimsdragon-thumbnail.png" alt="Kim's Dragon Thumbnail">

                </picture>
              </div>
              <div class="info">
                <div class="info">
                    <h1>Video</h1>
                  </div>
              </div>
            </a>


            <a href="/kims-dragon" class="box drawing">
              <div class="visual">
                <picture>
                  <img src="/images/LennoxGotLunch/lennoxgotlunch-thumbnail.png" alt="Kim's Dragon Thumbnail">

                </picture>
              </div>
              <div class="info">
                <h1>Drawing</h1>
              </div>
            </a>




  </section>
</Layout>
